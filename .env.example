# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER prefix these with NEXT_PUBLIC_ (that would ship them to the browser).

# Required: DeepSeek API key (server only).
DEEPSEEK_API_KEY=

# Recommended in production: shared rate-limit counters (see supabase/rate-limit.sql).
# Without them the limits only apply per server instance.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: any random string; makes the stored IP hashes impossible to reverse by guessing.
RATE_LIMIT_SALT=

# Optional tuning (defaults shown).
# RATE_LIMIT_PER_IP=20
# RATE_LIMIT_WINDOW_SECONDS=600
# RATE_LIMIT_DAILY=500

# Optional: extra origins allowed to call /api/chat, comma-separated (the site's own origin is always allowed).
# ALLOWED_ORIGINS=https://www.tu-dominio.com
